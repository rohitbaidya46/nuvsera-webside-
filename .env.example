# ───────────────────────── Required ─────────────────────────
# PostgreSQL connection string (add ?sslmode=require for managed databases)
DATABASE_URL="postgresql://nuvsera:CHANGE_ME@localhost:5432/nuvsera"
# Public base URL, no trailing slash
APP_URL="https://nuvseratechnology.com"
# Generate with: openssl rand -base64 48
APP_SECRET=""
# 32-byte hex key that encrypts 2FA secrets, the SMTP password and backups. Generate with: openssl rand -hex 32
# Store it safely. If you lose it, existing 2FA enrolments and backups can't be read.
ENCRYPTION_KEY=""
# Shared secret for /api/cron/* (Vercel Cron sends it automatically). Generate with: openssl rand -hex 24
CRON_SECRET=""
# Set to "true" ONLY on the live production domain (staging and previews stay noindex)
SITE_INDEXABLE="false"

# ───────────────────────── Spam protection (hCaptcha) ─────────────────────────
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET=""

# ───────────────────────── File storage ─────────────────────────
# "local" (Docker volume / VM disk), "s3" (Amazon S3) or "database" (store in PostgreSQL — default on Vercel)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION="ap-south-1"
# On AWS prefer an IAM role; otherwise set:
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ───────────────────────── Email (fallback; can also be set in Admin → Site settings) ─────────────────────────
# Amazon SES SMTP: email-smtp.ap-south-1.amazonaws.com, port 587
# Brevo:           smtp-relay.brevo.com, port 587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@nuvseratechnology.com"

# ───────────────────────── Backups ─────────────────────────
BACKUP_RETENTION_DAYS="30"

# ───────────────────────── First admin (used once by the seed script) ─────────────────────────
SEED_ADMIN_EMAIL="admin@nuvseratechnology.com"
# Leave blank to have a random temporary password generated and printed once
SEED_ADMIN_PASSWORD=""

# ───────────────────────── Docker compose only ─────────────────────────
POSTGRES_PASSWORD=""
