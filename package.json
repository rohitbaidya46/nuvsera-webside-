{
  "name": "nuvsera-website",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate website and admin panel for Nuvsera Technology Private Limited",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:decrypt": "tsx scripts/decrypt-backup.ts",
    "test:smoke": "tsx tests/smoke.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@hcaptcha/react-hcaptcha": "1.12.1",
    "@prisma/client": "6.19.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "framer-motion": "14.14.0",
    "gsap": "3.15.1",
    "lenis": "1.3.28",
    "lucide-react": "0.553.0",
    "next": "15.5.29",
    "nodemailer": "7.0.10",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanitize-html": "2.17.0",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "simple-icons": "15.22.0",
    "three": "0.187.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/typography": "0.5.19",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.19.1",
    "@types/nodemailer": "7.0.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sanitize-html": "2.16.0",
    "@types/three": "0.187.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
