# Scheduled jobs for the self-hosted stack (times in UTC). CRON_SECRET comes from .env.
# Uses busybox wget (built into Alpine) so the scheduler needs no package downloads.
*/15 * * * * wget -q -O /dev/null --header "Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/reminders
0 21 * * * wget -q -O /dev/null --header "Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/backup
