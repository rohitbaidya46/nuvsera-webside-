# Caddy: automatic HTTPS (Let's Encrypt) in front of the Next.js app.
# DOMAIN comes from .env (e.g. nuvseratechnology.com).
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	# Uploads are limited to 10 MB by the app; allow a little headroom for form fields.
	request_body {
		max_size 12MB
	}
	reverse_proxy app:3000
	log {
		output stdout
		format console
	}
}
